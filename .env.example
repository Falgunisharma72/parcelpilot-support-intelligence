# Required for the chat agent. Everything else - document parsing, the rules
# registry, the decision engines, the signals dashboard and the whole test
# suite - runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# PARCELPILOT_MODEL=claude-opus-5
# PARCELPILOT_EFFORT=high          # low | medium | high | xhigh | max
# PARCELPILOT_MAX_TOKENS=8000
# PARCELPILOT_SHOW_THINKING=1      # stream the reasoning summary into the UI
# PARCELPILOT_MAX_AGENT_STEPS=12
# PARCELPILOT_PROPOSAL_TTL=900     # seconds a pending action stays confirmable
