# ---------------------------------------------------------------------------
# Model provider — set ONE of these. Every option below has a free tier.
# ---------------------------------------------------------------------------
# The provider is auto-detected from whichever key is present, in this order.
# Run `make providers` to see the options and test that yours works.

# Groq — recommended. Generous free tier, no card, very fast, reliable tool
# calling. https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — free tier from AI Studio, no card.
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Cerebras — free tier, no card.   https://cloud.cerebras.ai
# CEREBRAS_API_KEY=

# OpenRouter — models suffixed ':free' cost nothing.
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Mistral — free experiment tier.  https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# Together AI — starting credit.   https://api.together.ai/settings/api-keys
# TOGETHER_API_KEY=

# Anthropic — paid, highest quality, not required.
# ANTHROPIC_API_KEY=

# No key at all: install Ollama, `ollama pull qwen2.5:7b`, and it is detected
# automatically. Nothing leaves your machine.

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# PARCELPILOT_PROVIDER=groq        # force one instead of auto-detecting
# PARCELPILOT_MODEL=...            # override that provider's default model
# PARCELPILOT_MAX_TOKENS=4096
# PARCELPILOT_MAX_AGENT_STEPS=12
# PARCELPILOT_PROPOSAL_TTL=900     # seconds a pending action stays confirmable
# PARCELPILOT_EFFORT=high          # Anthropic only
# PARCELPILOT_SHOW_THINKING=1      # stream the reasoning summary into the UI
